# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
*.spec.bak

# Portable-mode data written next to a frozen build
data/

# Knowledge learned at runtime (internet learning, Jarvis feedback). User-local
# state, not curated release content, so it is never committed.
documents/

# How far each learning query has been paged; advances on every write run.
learned_cursor.json

# The built bulk knowledge base (large; rebuild with `python -m cli knowledge
# build`). Lives under the data directory, but in source mode that is the repo
# root, so ignore it explicitly too.
knowledge_base/

# Test / coverage artifacts
.pytest-tmp/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store

# Local environment files
.env

# Learned ML artifacts. For releases these are committed on purpose so a clone
# ships the trained state (see `python -m ml.release`); the manifest records how
# they were produced. Regenerate with `python -m ml.release`.
!ml/artifacts/
